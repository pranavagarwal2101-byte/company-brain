# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is gitignored; never put real credentials in this file.

# Gemini API key - get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Free tier allows 5 requests/minute; agent.py paces itself to this.
# Raise it if your key is on a paid tier.
GEMINI_REQUESTS_PER_MINUTE=5

# FalkorDB connection. Defaults below are for local Docker.
# For FalkorDB Cloud, use the host and port from your instance's connection page.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=company_brain

# Only for FalkorDB Cloud (leave blank for local Docker)
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Leave false unless your instance's connection page says TLS is required.
FALKORDB_SSL=false
