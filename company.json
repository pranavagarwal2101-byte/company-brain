  "incidents": [
    {
      "id": "INC-212",
      "title": "Ledger overload from payment retry storm",
      "occurred_at": "2025-03-14",
      "severity": "SEV1",
      "summary": "A downstream timeout caused payments-service to retry five times per request. The retry volume saturated ledger-db connections and caused 42 minutes of failed settlements."
    },
    {
      "id": "INC-287",
      "title": "Duplicate charges during gateway failover",
      "occurred_at": "2025-06-02",
      "severity": "SEV1",
      "summary": "During an api-gateway failover, retried requests without idempotency keys produced duplicate charges for 1,204 customers."
    },
    {
      "id": "INC-301",
      "title": "SSO login failures after token format change",
      "occurred_at": "2024-07-22",
      "severity": "SEV2",
      "summary": "A token format change in auth-service broke session validation for users whose records predated the user-store migration."
    },
    {
      "id": "INC-355",
      "title": "Notification backlog during month-end settlement",
      "occurred_at": "2026-01-31",
      "severity": "SEV2",
      "summary": "notification-service queued 300k payment confirmations during month-end and fell four hours behind, since each confirmation triggered a synchronous call to payments-service."
    },
    {
      "id": "INC-370",
      "title": "Audit log gap during ledger maintenance",
      "occurred_at": "2026-02-18",
      "severity": "SEV3",
      "summary": "audit-log silently dropped events for 90 minutes while ledger-db was in maintenance mode, leaving a compliance gap."
    }
  ],

