  "documents": [
    {
      "id": "RFC-47",
      "title": "Bounded retries for payment settlement",
      "type": "RFC",
      "url": "https://wiki.acme.io/rfc/47",
      "created_at": "2025-03-28",
      "author": "riya.sharma@acme.io",
      "body": "Following INC-212 we propose capping settlement retries at three attempts with exponential backoff. Five attempts was chosen arbitrarily in 2023 and under sustained downstream latency it multiplies connection pressure on ledger-db by 5x. Three attempts recovers 97.3% of transient failures in our replay analysis while bounding worst-case ledger load. Anything beyond three should be routed to the dead letter queue for manual settlement."
    },
    {
      "id": "RFC-52",
      "title": "Idempotency keys for all mutating payment endpoints",
      "type": "RFC",
      "url": "https://wiki.acme.io/rfc/52",
      "created_at": "2025-06-20",
      "author": "aman.gupta@acme.io",
      "body": "INC-287 produced duplicate charges because retried requests were indistinguishable from new ones. Every mutating endpoint on payments-service must accept an Idempotency-Key header, persisted in ledger-db with a 24 hour uniqueness window. This interacts with the bounded retry policy from RFC-47: retries are only safe because they are now idempotent."
    },
    {
      "id": "RFC-61",
      "title": "Asynchronous notification dispatch",
      "type": "RFC",
      "url": "https://wiki.acme.io/rfc/61",
      "created_at": "2026-02-10",
      "author": "priya.nair@acme.io",
      "body": "INC-355 showed that synchronous confirmation calls from notification-service into payments-service do not survive month-end volume. We move to batched asynchronous dispatch with a 30 second window, decoupling notification throughput from settlement throughput."
    },
    {
      "id": "RFC-33",
      "title": "Single sign-on migration plan",
      "type": "RFC",
      "url": "https://wiki.acme.io/rfc/33",
      "created_at": "2024-08-05",
      "author": "mei.tanaka@acme.io",
      "body": "Migrate auth-service session handling to SSO with a backward compatible token format. Legacy records in user-store must be backfilled before the old format is retired."
    },
    {
      "id": "POSTMORTEM-212",
      "title": "Postmortem: INC-212 ledger overload",
      "type": "postmortem",
      "url": "https://wiki.acme.io/pm/212",
      "created_at": "2025-03-17",
      "author": "omar.haddad@acme.io",
      "body": "Root cause: unbounded retry amplification under downstream latency. Contributing factor: no circuit breaker between payments-service and ledger-db. Action items: cap retries (see RFC-47), add connection pool alerting, document the settlement dead letter path."
    },
    {
      "id": "POSTMORTEM-287",
      "title": "Postmortem: INC-287 duplicate charges",
      "type": "postmortem",
      "url": "https://wiki.acme.io/pm/287",
      "created_at": "2025-06-05",
      "author": "ines.duarte@acme.io",
      "body": "Root cause: non-idempotent mutating endpoints combined with gateway-level retry on failover. 1,204 customers were double charged and refunded within 48 hours. Action item: idempotency keys (see RFC-52)."
    },
    {
      "id": "RUNBOOK-PAY",
      "title": "Runbook: payments-service on-call",
      "type": "runbook",
      "url": "https://wiki.acme.io/runbook/payments",
      "created_at": "2025-09-01",
      "author": "omar.haddad@acme.io",
      "body": "Settlement failure alerts page the Payments on-call. Check ledger-db connection pool saturation first. Retries are capped at three per RFC-47; if you see more than three attempts for a single payment id, that is a bug, not load. Escalate to the payments-service owner."
    },
    {
      "id": "ADR-09",
      "title": "Audit events written asynchronously",
      "type": "ADR",
      "url": "https://wiki.acme.io/adr/09",
      "created_at": "2026-03-02",
      "author": "leila.hassan@acme.io",
      "body": "INC-370 revealed that audit-log drops events when ledger-db is unavailable. We move audit writes behind a durable queue so maintenance windows no longer create compliance gaps."
    },
    {
      "id": "ONBOARD-PAY",
      "title": "Payments team onboarding guide",
      "type": "guide",
      "url": "https://wiki.acme.io/onboarding/payments",
      "created_at": "2026-04-12",
      "author": "nikhil.rao@acme.io",
      "body": "Start with the settlement flow: api-gateway to payments-service to ledger-db. Read RFC-47 and RFC-52 together, they explain why retries look the way they do. The retry cap is three, and that number has a history."
    }
  ],

